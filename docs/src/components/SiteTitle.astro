---
import { Image } from 'astro:assets';
import logo from '../assets/app-icon.png';
import { version } from '../../package.json';

/** Releases live in the upstream repo; `latest` always points at the newest one. */
const LATEST_RELEASE_URL = 'https://github.com/coolcoala/koala-clash/releases/latest';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<Image src={logo} alt="" width={72} height={72} draggable="false" class="mark" />
	<span translate="no">Koala Clash</span>
</a>
<a
	href={LATEST_RELEASE_URL}
	class="version"
	target="_blank"
	rel="noopener noreferrer"
	title={Astro.locals.t('siteTitle.latestRelease')}
>
	{version}
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		font-family: var(--kc-font-heading);
		font-size: 1.125rem;
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--kc-ink);
		text-decoration: none;
		white-space: nowrap;
	}

	.mark {
		width: 2.25rem;
		height: 2.25rem;
		flex-shrink: 0;
		filter: drop-shadow(0 2px 6px oklch(0 0 0 / 0.3));
		user-select: none;
		transition: transform 0.2s;
	}

	.site-title:hover .mark {
		transform: rotate(-6deg);
	}

	span {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.version {
		flex-shrink: 0;
		border: 1px solid var(--kc-border);
		border-radius: 999px;
		background-color: var(--kc-muted);
		padding: 0.1875rem 0.5rem;
		font-size: var(--sl-text-2xs);
		font-weight: 600;
		line-height: 1;
		color: var(--kc-brand-text);
		text-decoration: none;
		transition: color 0.15s, border-color 0.15s;
	}

	.version:hover {
		border-color: var(--kc-stroke);
		color: var(--kc-ink);
	}

	@media (prefers-reduced-motion: reduce) {
		.mark {
			transition: none;
		}
	}
</style>
